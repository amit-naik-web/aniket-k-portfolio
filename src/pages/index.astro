import PreviewListShowCase from "../components/previewListShowCase3.astro";
import ReviewSection1 from "../components/reviewSection1.astro";
// import ModelViewer1 from "../components/ModelViewer1.astro";
import ModelViewer3 from "../components/ModelViewer3.astro";
import Hero3 from "../components/hero3.astro";
// import Hero4 from "../components/Hero4.astro";
import CTA from "../components/CTA.astro";
// import PhotoballHero from "../components/PhotoballHero.astro";
---

<Layout title="01byte10">
  <!-- Hero Section -->
  <!-- <video
    class="w-full h-[100vh] object-cover"
    src="/korolova.mp4"
    autoplay
    muted
    loop
    playsinline
  >
    Your browser does not support the video tag.
  </video> -->
  <!-- <PhotoballHero /> -->
  <!-- <Hero4 /> -->
  <!-- Overlap stack: Hero3 on top scrolls away, revealing ModelViewer already behind -->
  <div class="hero-model-overlap">
    <div class="hero-model-overlap__front">
      <Hero3 />
