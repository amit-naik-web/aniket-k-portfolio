  <!-- Scroll Animation Section - Middle div grows with background shift -->
  <!-- <ScrollAnimationSection /> -->

  <!-- Split Screen Overlay - Zoom out effect revealing background -->
  <!-- <SplitScreenOverlay /> -->

  <!-- Review Section -->
  <div class="h-[40vh] w-full"></div>

  <!-- Noomo-style scroll review section -->
  <ReviewSection1 />
