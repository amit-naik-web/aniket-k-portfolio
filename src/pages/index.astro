</Layout>

<style>
  body {
    /* clip keeps sticky/pin sections working; hidden breaks position:sticky */
    overflow-x: clip;
    margin: 0;
    padding: 0;
  }

  html {
    overflow-x: clip;
    scroll-behavior: smooth;
  }

  /*
    Hero / Model overlap:
    Model sits under Hero3's last 100vh exit. Hero slides up over the model's
    intro pose; ModelViewer3 holds animation until that reveal finishes.
  */
  .hero-model-overlap {
    position: relative;
    isolation: isolate;
  }

  .hero-model-overlap__front {
    position: relative;
    z-index: 2;
  }

  .hero-model-overlap__behind {
    position: relative;
    z-index: 1;
    /* Tuck under Hero3 exit viewport — model is present at intro pose underneath */
    margin-top: -100vh;
  }

  .hero-model-overlap__front :global(.hero-wrapper) {
    /* Panels own the media; keep wrapper clear so the reveal isn't a black slab */
    background: transparent;
  }

  /* Hero Section Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section > div > * {
    animation: fadeInUp 1s ease-out forwards;
  }

  section > div > *:nth-child(2) {
    animation-delay: 0.2s;
  }

  section > div > *:nth-child(3) {
    animation-delay: 0.4s;
  }

  /* Video zoom effect on hover */
  video {
    transition: transform 20s ease-out;
  }

  section:hover video {
    transform: scale(1.05);
  }

  /* See-through text effect - video shows through the text */
  .see-through-text {
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
    text-stroke: 2px rgba(255, 255, 255, 0.9);
    paint-order: stroke fill;
  }

  /* Add glow effect for better visibility */
  @supports (-webkit-text-stroke: 1px white) {
    .see-through-text {
      filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.5));
    }
  }
</style>
