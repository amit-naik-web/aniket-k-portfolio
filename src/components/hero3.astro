---
export interface Props {
  line1?: string;
  line2?: string;
  videoSrc?: string;
}

const {
  line1 = "Crafting",
  line2 = "Culture.",
  videoSrc = "/korolova.mp4",
} = Astro.props;
---

<!-- ═══════════════════════════════════════════════════════════════════
     FIRST 100VH — visible on page load (no scroll needed)
     • Background: hero-section data-index="0" (inside .hero-wrapper)
     • Text overlay: section-text data-section="0" (sibling below wrapper)
     ═══════════════════════════════════════════════════════════════════ -->

<div class="hero-wrapper">
  <!-- FIRST 100VH: background video + grain -->
  <div class="hero-section hero-section--intro" data-index="0">
    <video class="hero-media crafting-culture-hero__bg-video" autoplay muted loop playsinline aria-hidden="true">
      <source src={videoSrc} type="video/mp4" />
    </video>
    <div class="crafting-culture-hero__grain" aria-hidden="true"></div>
  </div>

  <!-- Transition slide: CAPTURE (slides up over intro on scroll) -->
  <div class="hero-section" data-index="1">
    <video class="hero-media" autoplay muted loop playsinline>
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>

  <div class="hero-section" data-index="2">
    <img class="hero-media" src="/coldplay.jpg" alt="Coldplay" />
  </div>

  <div class="hero-section" data-index="2">
    <video class="hero-media" autoplay muted loop playsinline>
      <source src="/martin-garrix.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hero-section" data-index="4">
    <img class="hero-media" src="/Fisher.jpg" alt="Fisher" />
  </div>
</div>

<!-- FIRST 100VH: headline text (fixed layer, pairs with data-index="0") -->
<div class="section-text section-text--intro" data-section="0">
  <h1 class="crafting-culture-hero__title" aria-label="Crafting Culture">
    <span class="crafting-culture-hero__line crafting-culture-hero__line--solid">{line1}</span>
    <span class="crafting-culture-hero__line crafting-culture-hero__line--outline">{line2}</span>
  </h1>
</div>

<div class="section-text" data-section="1">
  <h1>CAPTURE</h1>
</div>

<div class="section-text" data-section="2">
  <h1>ELEVATE</h1>
</div>

<div class="section-text" data-section="3">
  <h1>AMPLIFY</h1>
</div>

<div class="section-text" data-section="4">
  <h1>UNLEASH</h1>
</div>

<script>
  function initHero() {
    const wrapper = document.querySelector('.hero-wrapper') as HTMLElement;
    const sections = document.querySelectorAll('.hero-section');
    const texts = document.querySelectorAll('.section-text');
    
    if (!wrapper || !sections.length || !texts.length) return;

    let currentScroll = 0;
    let targetScroll = 0;

    function updateSections() {
      targetScroll = window.pageYOffset;
      currentScroll += (targetScroll - currentScroll) * 0.1;

      const vh = window.innerHeight;
      const wrapperTop = wrapper.offsetTop;
      const wrapperHeight = wrapper.offsetHeight;
      const scrolled = currentScroll - wrapperTop;

      if (scrolled > wrapperHeight) {
        sections.forEach((section) => {
          (section as HTMLElement).style.opacity = '0';
        });
        texts.forEach((text) => {
          (text as HTMLElement).style.opacity = '0';
        });
        return;
      }

      sections.forEach((section) => {
        (section as HTMLElement).style.opacity = '1';
      });
      texts.forEach((text) => {
        (text as HTMLElement).style.opacity = '1';
      });

      sections.forEach((section, index) => {
        const el = section as HTMLElement;
        const text = texts[index] as HTMLElement;
        
        const sectionStart = index * vh;
        const progress = (scrolled - sectionStart) / vh;
        const slideAmount = Math.max(0, (1 - progress) * 100);

        const hasNextSection = index < sections.length - 1;
        let nextSlideAmount = 100;
        
        if (hasNextSection) {
          const nextSectionStart = (index + 1) * vh;
          const nextProgress = (scrolled - nextSectionStart) / vh;
          nextSlideAmount = Math.max(0, (1 - nextProgress) * 100);
        }

        el.style.zIndex = (index + 1).toString();

        // Section 0: visible immediately at scroll 0; later sections slide up on scroll
        if (index === 0) {
          el.style.transform = 'translateY(0)';
        } else if (scrolled < sectionStart) {
          el.style.transform = 'translateY(100%)';
        } else if (progress >= 0 && progress < 1) {
          el.style.transform = `translateY(${slideAmount}%)`;
        } else {
          el.style.transform = 'translateY(0)';
        }

        if (text) {
          if (index === 0) {
            if (nextSlideAmount < 100) {
              const bottomClip = 100 - nextSlideAmount;
              text.style.clipPath = `inset(0 0 ${bottomClip}% 0)`;
            } else {
              text.style.clipPath = 'inset(0 0 0 0)';
            }
          } else if (scrolled < sectionStart) {
            text.style.clipPath = 'inset(100% 0 0 0)';
          } else if (progress >= 0 && progress < 1) {
            text.style.clipPath = `inset(${slideAmount}% 0 0 0)`;
          } else if (nextSlideAmount < 100) {
            const bottomClip = 100 - nextSlideAmount;
            text.style.clipPath = `inset(0 0 ${bottomClip}% 0)`;
          } else {
            text.style.clipPath = 'inset(0 0 0 0)';
          }
        }
      });
    }

    function animate() {
      updateSections();
      requestAnimationFrame(animate);
    }

    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    height: 500vh;
    background: #000;
  }

  .hero-section {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    transform: translateY(100%);
    opacity: 1;
    transition: opacity 0.3s ease-out;
    will-change: transform, opacity;
  }

  /* First 100vh: show intro section on load (overridden by JS, but safe fallback) */
  .hero-section--intro {
    transform: translateY(0);
  }

  .hero-media {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  .hero-section--intro .crafting-culture-hero__bg-video {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    transform: none;
    object-fit: cover;
    pointer-events: none;
  }

  .crafting-culture-hero__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.12;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .section-text {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 1;
    clip-path: inset(100% 0 0 0);
    transition: opacity 0.3s ease-out;
    will-change: clip-path, opacity;
  }

  /* First 100vh: show intro text on load */
  .section-text--intro {
    clip-path: inset(0 0 0 0);
  }

  .section-text[data-section="0"] { z-index: 101; }
  .section-text[data-section="1"] { z-index: 102; }
  .section-text[data-section="2"] { z-index: 103; }
  .section-text[data-section="3"] { z-index: 104; }
  .section-text[data-section="4"] { z-index: 105; }

  .section-text h1 {
    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 700;
    color: white;
    line-height: 1.1;
    text-align: center;
    margin: 0;
    padding: 0 2rem;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }

  .section-text--intro .crafting-culture-hero__title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0.06em 0.04em;
    box-sizing: border-box;
    text-transform: uppercase;
    font-family: 'Red Hat Display', 'DM Sans', sans-serif;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-shadow: none;
    animation: craftingHeroIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .crafting-culture-hero__line {
    display: block;
    width: 100%;
    line-height: 0.76;
    text-align: center;
    font-size: clamp(3.5rem, min(22vw, 38svh), 28rem);
  }

  .crafting-culture-hero__line--solid {
    color: #fff;
    text-shadow: 0 0 80px rgba(255, 255, 255, 0.08);
  }

  .crafting-culture-hero__line--outline {
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.92);
    text-stroke: 2px rgba(255, 255, 255, 0.92);
    paint-order: stroke fill;
    text-shadow: none;
  }

  .crafting-culture-hero__line:nth-child(2) {
    animation: craftingLineIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  .crafting-culture-hero__line:nth-child(1) {
    animation: craftingLineIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes craftingHeroIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes craftingLineIn {
    from {
      opacity: 0;
      transform: translateY(0.12em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .section-text h1 {
      font-size: clamp(2rem, 10vw, 3rem);
      padding: 0 1.5rem;
    }

    .crafting-culture-hero__line {
      font-size: clamp(2.75rem, 18vw, 6rem);
      letter-spacing: -0.03em;
    }

    .crafting-culture-hero__line--outline {
      -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.92);
      text-stroke: 1.5px rgba(255, 255, 255, 0.92);
    }
  }
</style>
