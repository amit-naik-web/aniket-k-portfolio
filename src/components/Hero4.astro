---
export interface Props {
  line1?: string;
  line2?: string;
  videoSrc?: string;
}

const {
  line1 = "Crafting",
  line2 = "Culture.",
  videoSrc = "/korolova.mp4",
} = Astro.props;
---

<div class="crafting-culture-hero">
  <video
    class="crafting-culture-hero__bg-video"
    src={videoSrc}
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  ></video>
  <div class="crafting-culture-hero__grain" aria-hidden="true"></div>
  <h1 class="crafting-culture-hero__title" aria-label="Crafting Culture">
    <span class="crafting-culture-hero__line crafting-culture-hero__line--solid">{line1}</span>
    <span class="crafting-culture-hero__line crafting-culture-hero__line--outline">{line2}</span>
  </h1>
</div>

<style>
  .crafting-culture-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .crafting-culture-hero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    z-index: 0;
  }

  .crafting-culture-hero__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.12;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .crafting-culture-hero__title {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0.06em 0.04em;
    box-sizing: border-box;
    text-transform: uppercase;
    font-family: 'Red Hat Display', 'DM Sans', sans-serif;
    font-weight: 800;
    letter-spacing: -0.045em;
    animation: craftingHeroIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .crafting-culture-hero__line {
    display: block;
    width: 100%;
    line-height: 0.76;
    text-align: center;
    font-size: clamp(3.5rem, min(22vw, 38svh), 28rem);
  }

  .crafting-culture-hero__line--solid {
    color: #fff;
    text-shadow: 0 0 80px rgba(255, 255, 255, 0.08);
  }

  .crafting-culture-hero__line--outline {
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.92);
    text-stroke: 2px rgba(255, 255, 255, 0.92);
    paint-order: stroke fill;
    text-shadow: none;
  }

  .crafting-culture-hero__line:nth-child(2) {
    animation: craftingLineIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  .crafting-culture-hero__line:nth-child(1) {
    animation: craftingLineIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes craftingHeroIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes craftingLineIn {
    from {
      opacity: 0;
      transform: translateY(0.12em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .crafting-culture-hero__line {
      font-size: clamp(2.75rem, 18vw, 6rem);
      letter-spacing: -0.03em;
    }

    .crafting-culture-hero__line--outline {
      -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.92);
      text-stroke: 1.5px rgba(255, 255, 255, 0.92);
    }
  }
</style>
