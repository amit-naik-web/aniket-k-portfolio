<section class="cta-scroll" data-cta-section>
  <div class="cta-sticky" data-cta-sticky>
    <div class="cta-frame" data-cta-frame>
      <div class="cta-content-bg"></div>
      <div class="cta-inner" data-cta-inner>
        <h2 class="cta-heading">Got a vision worth amplifying<span class="cta-heading-dot">?</span></h2>
        <a href="/contact" class="cta-btn">
          <span class="cta-btn-label">Let's get in touch</span>
          <svg class="cta-btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="cta-grid" aria-hidden="true">
        <span class="cta-center-dot">
          <svg width="200" height="200" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
            <circle fill="#ff0000" stroke="none" cx="60" cy="60" r="12">
              <animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.1" />
            </circle>
          </svg>
        </span>
        <span class="cta-icon-wrap cta-cell-top-left">
          <svg class="cta-icon" width="50" height="50" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="20" height="50" rx="2" fill="#fff"></rect>
            <rect x="0" y="0" width="50" height="20" rx="2" fill="#fff"></rect>
          </svg>
        </span>
        <span class="cta-icon-wrap cta-cell-top-right">
          <svg class="cta-icon" width="50" height="50" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="0" width="20" height="50" rx="2" fill="#fff"></rect>
            <rect x="0" y="0" width="50" height="20" rx="2" fill="#fff"></rect>
          </svg>
        </span>
        <span class="cta-icon-wrap cta-cell-bottom-left">
          <svg class="cta-icon" width="50" height="50" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="20" height="50" rx="2" fill="#fff"></rect>
            <rect x="0" y="30" width="50" height="20" rx="2" fill="#fff"></rect>
          </svg>
        </span>
        <span class="cta-icon-wrap cta-cell-bottom-right">
          <svg class="cta-icon" width="50" height="50" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="0" width="20" height="50" rx="2" fill="#fff"></rect>
            <rect x="0" y="30" width="50" height="20" rx="2" fill="#fff"></rect>
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-scroll {
    --enter-progress: 0;
    --split-progress: 0;
    --frame-y: calc((1 - var(--enter-progress)) * 55vh);
    --frame-scale: calc(0.65 + var(--enter-progress) * 0.95);
    --piece-size: 50px;
    --piece-gap: 0.7rem;
    --piece-x: calc(var(--split-progress) * 15rem);
    --piece-y: calc(var(--split-progress) * 5rem);
    --icon-opacity: calc(0.22 + var(--enter-progress) * 0.78);
    /* Pin scroll distance lives on ScrollTrigger end; keep section 100vh tall */
    height: 100vh;
    width: 100%;
    align-self: stretch;
    position: relative;
    z-index: 1;
  }

  .cta-sticky {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }

  .cta-frame {
    position: relative;
    transform: translateY(var(--frame-y)) scale(var(--frame-scale));
    transform-origin: center;
    will-change: transform;
    pointer-events: none;
    animation: none !important;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(2, var(--piece-size));
    grid-template-rows: repeat(2, var(--piece-size));
    gap: var(--piece-gap);
    position: relative;
  }

  .cta-content-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(2 * var(--piece-x) + 10px + var(--piece-gap));
    height: calc(2 * var(--piece-y) + 10px + var(--piece-gap));
    background: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    opacity: calc((var(--split-progress) - 0.7) * 3.33);
    pointer-events: none;
    backdrop-filter: blur(2px);
  }

  .cta-center-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    opacity: calc(1 - var(--split-progress) * 5);
    pointer-events: none;
  }

  .cta-icon-wrap {
    width: var(--piece-size);
    height: var(--piece-size);
    display: inline-flex;
    opacity: var(--icon-opacity);
    will-change: transform;
  }

  .cta-cell-top-left {
    transform: translate(calc(-1 * var(--piece-x)), calc(-1 * var(--piece-y)));
  }

  .cta-cell-top-right {
    transform: translate(var(--piece-x), calc(-1 * var(--piece-y)));
  }

  .cta-cell-bottom-left {
    transform: translate(calc(-1 * var(--piece-x)), var(--piece-y));
  }

  .cta-cell-bottom-right {
    transform: translate(var(--piece-x), var(--piece-y));
  }

  .cta-icon {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .cta-icon rect {
    fill: #fff !important;
  }

  @media (max-width: 900px) {
    .cta-scroll {
      --piece-x: calc(var(--split-progress) * 11.4rem);
      --piece-y: calc(var(--split-progress) * 3.8rem);
    }
  }

  .cta-inner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    pointer-events: none;
    white-space: nowrap;
    --cta-reveal: calc((var(--split-progress) - 0.82) * 5.56);
  }

  .cta-inner.is-revealed {
    pointer-events: auto;
  }

  .cta-heading {
    font-family: inherit;
    font-size: clamp(1.35rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
    opacity: var(--cta-reveal, 0);
    transform: translateY(calc((1 - var(--cta-reveal, 0)) * 22px));
  }

  .cta-heading-dot {
    color: #646cff;
  }

  .cta-sub {
    font-size: clamp(0.82rem, 1.4vw, 1rem);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    font-weight: 400;
    opacity: var(--cta-reveal, 0);
    transform: translateY(calc((1 - var(--cta-reveal, 0)) * 18px));
    transition-delay: 0.06s;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.7rem 1.7rem;
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50px;
    text-decoration: none;
    cursor: pointer;
    backdrop-filter: blur(6px);
    opacity: var(--cta-reveal, 0);
    transform: translateY(calc((1 - var(--cta-reveal, 0)) * 16px));
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s, transform 0.2s;
  }

  .cta-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 0 24px rgba(100, 108, 255, 0.25);
  }

  .cta-btn:hover .cta-btn-arrow {
    transform: translateX(3px);
  }

  .cta-btn-label {
    position: relative;
  }

  .cta-btn-arrow {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .cta-inner {
      gap: 0.45rem;
    }
    .cta-btn {
      padding: 0.6rem 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-scroll {
      --enter-progress: 1;
      --split-progress: 1;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initCta() {
    const ctaSection = document.querySelector("[data-cta-section]");
    const ctaInner = document.querySelector("[data-cta-inner]");
    if (!(ctaSection instanceof HTMLElement)) return;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), max);
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    // Pin CTA in document flow (same model as review) — no position:fixed overlay
    ScrollTrigger.create({
      trigger: ctaSection,
      pin: true,
      pinSpacing: true,
      start: "top top",
      end: "+=2000",
      anticipatePin: 1,
      onUpdate: (self) => {
        const p = self.progress;
        // 0–0.35 enter, 0.2–0.85 split
        const enter = easeOutCubic(clamp(p / 0.35, 0, 1));
        const split = easeOutCubic(clamp((p - 0.2) / 0.65, 0, 1));
        ctaSection.style.setProperty("--enter-progress", enter.toFixed(4));
        ctaSection.style.setProperty("--split-progress", split.toFixed(4));
        ctaInner?.classList.toggle("is-revealed", split > 0.88);
      },
    });

    ScrollTrigger.refresh();
  }

  if (document.readyState === "complete") {
    initCta();
  } else {
    window.addEventListener("load", initCta);
  }
</script>
